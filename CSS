@charset "UTF-8";

/* -------------------------
   全体
-------------------------- */

*{
    font-family:sans-serif;
    box-sizing:border-box;
}

body{
    margin:0;
    background-color:#e8f5e9;
    color:#333;
}

/* -------------------------
   Header
-------------------------- */

header{

    background-color:#2e8b57;
    color:white;
    padding:30px;

}

h1{

    text-align:center;
    font-size:42px;
    letter-spacing:5px;
    margin:0;

}

nav{

    text-align:center;
    margin-top:20px;

}

nav a{

    color:white;
    text-decoration:none;
    margin:15px;
    font-weight:bold;

}

nav a:hover{

    color:yellow;

}

/* -------------------------
   Main
-------------------------- */

main{

    padding:30px;

}

h2{

    text-align:center;
    background-color:#66bb6a;
    color:white;
    padding:15px;
    border-radius:10px;

}

/* -------------------------
   Grid
-------------------------- */

.container{

    display:grid;
    grid-template-columns:1fr 1fr;
    gap:25px;
    margin-top:20px;

}

/* 表だけ横いっぱい */

.container section:last-child{

    grid-column:1/3;

}

/* -------------------------
   Section
-------------------------- */

section{

    background-color:white;
    border:2px solid #2e8b57;
    border-radius:15px;
    padding:20px;

    transition:0.3s;

}

section:hover{

    transform:scale(1.03);

}

h3{

    background-color:#b2dfdb;
    padding:10px;
    border-radius:8px;
    text-align:center;

}

h3:hover{

    border:2px solid red;

}

/* -------------------------
   リスト
-------------------------- */

ul{

    list-style:circle;

}

ol{

    list-style:decimal;

}

/* -------------------------
   リンク
-------------------------- */

a:link{

    color:#1565c0;

}

a:visited{

    color:purple;

}

a:hover{

    color:red;
    font-size:1.1em;

}

/* -------------------------
   画像
-------------------------- */

img{

    width:100%;
    height:250px;
    object-fit:cover;
    border-radius:10px;
    border:3px solid #2e8b57;

}

/* -------------------------
   表
-------------------------- */

table{

    width:100%;
    border-collapse:collapse;

}

caption{

    font-size:20px;
    font-weight:bold;
    margin-bottom:10px;

}

th{

    background-color:#81c784;

}

th,
td{

    border:1px solid black;
    text-align:center;
    padding:10px;

}

tr:nth-child(even){

    background-color:#f1f8e9;

}

tr:nth-child(odd){

    background-color:white;

}

/* -------------------------
   ボタン
-------------------------- */

button{

    background-color:#ff9800;
    color:white;
    border:none;
    border-radius:10px;
    padding:12px 20px;
    font-size:18px;
    cursor:pointer;

}

button:hover{

    background-color:#ff5722;

}

/* -------------------------
   Footer
-------------------------- */

footer{

    background-color:#2e8b57;
    color:white;
    text-align:center;
    padding:20px;
    margin-top:30px;

}
