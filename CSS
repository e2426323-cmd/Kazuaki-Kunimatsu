@charset "UTF-8";

/* 全体 */

*{

font-family:sans-serif;

}

body{

margin:0;

background-color:#f5f5f5;

}

/* Header */

header{

background-color:#2E8B57;

color:white;

padding:30px;

}

h1{

text-align:center;

}

nav{

text-align:center;

}

/* Main */

main{

padding:20px;

}

h2{

text-align:center;

}

/* Grid */

.container{

display:grid;

grid-template-columns:1fr 1fr;

gap:24px;

}

/* 一番下の表 */

.container section:last-child{

grid-column:1/3;

}

/* Section */

section{

background-color:white;

border:2px solid black;

border-radius:10px;

padding:20px;

}

h3{

background-color:lightblue;

padding:10px;

}

h3:hover{

border:2px solid red;

}

/* リスト */

ul{

list-style:circle;

}

/* リンク */

a:link{

color:blue;

}

a:visited{

color:purple;

}

a:hover{

font-size:1.2em;

}

/* 画像 */

img{

width:100%;

height:auto;

border:2px solid black;

}

/* 表 */

table{

width:100%;

border-collapse:collapse;

}

caption{

font-weight:bold;

margin-bottom:10px;

}

th{

background-color:aquamarine;

}

th,
td{

border:1px solid black;

text-align:center;

padding:8px;

}

tr:nth-child(even){

background-color:#eeeeee;

}

tr:nth-child(odd){

background-color:white;

}

/* Footer */

footer{

background-color:lightgray;

text-align:center;

padding:20px;

margin-top:20px;

}

